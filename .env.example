# Copy this file to .env (Compose reads .env next to docker-compose.yml):
#   copy .env.example .env
#
# Fill in one LLM provider, then:
#   docker compose up production --build
# Dev with hot-reload:
#   docker compose up development --build
# There are no GPU compose services; GSlide calls LLMs over HTTP.
# App: http://localhost:5001
#
# After changing .env, recreate the container:
#   docker compose up production --force-recreate

# =============================================================================
# Minimal setup (enough to generate slides)
# =============================================================================

GSLIDE_HTTP_HOST_PORT=5001

# openai | google | custom
LLM=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# true = every signed-in user can save their own LLM/image/search keys.
# false = lock the Settings UI; keys must come from this .env (or the operator
# must seed them another way).
CAN_CHANGE_KEYS=true

# Optional: seed a user on first boot. Leave both blank to force the first
# visitor to register at /. Password must be at least 8 characters.
# AUTH_USERNAME=alice
# AUTH_PASSWORD=change-this-password

# Default Mem0 target is OpenAI. Disable unless OPENAI_API_KEY is set (or MEM0_LLM_* overridden).
MEM0_ENABLED=false

# Optional: skip slide images until an IMAGE_PROVIDER is configured.
DISABLE_IMAGE_GENERATION=true

DISABLE_ANONYMOUS_TRACKING=true

# Error reporting — PostHog (separate compose in deploy/posthog/, not started with GSlide).
# Browser-reachable URL, e.g. http://localhost:8010
# Never use a Docker-internal hostname (posthog:8000) — the browser cannot resolve it.
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=

# =============================================================================
# Docker / runtime
# =============================================================================

# Host port mapped to nginx :80 (same as GSLIDE_HTTP_HOST_PORT above).
# GSLIDE_HOST_HTTP_PORT=5001
#
# Compose sets FAST_API_INTERNAL_URL=http://api:8000 (Next → FastAPI) and
# EXPORT_PAGE_BASE_URL=http://proxy (Puppeteer → /pdf-maker). Leave those unset here.
# Do not set NEXT_PUBLIC_FAST_API in Docker (asset URLs stay path-only).

# linux/amd64 (default) | linux/arm64
# GSLIDE_DOCKER_PLATFORM=linux/amd64

# Leave empty to use SQLite under ./app_data. Compose already sets MIGRATE_DATABASE_ON_STARTUP=true.
# DATABASE_URL=postgresql://presenton:password@postgres:5432/presenton

# =============================================================================
# Platform multi-user mode (shared deployment)
# =============================================================================
#
# Multi-user is now the default. Anyone can register at / and sign in.
# Every signed-in user can save their own LLM/image/search keys in Settings
# (overlay); process env is the fallback. There is no admin role.
#
# DISABLE_AUTH=false (default)
# CAN_CHANGE_KEYS=false   # lock the Settings UI so users cannot add their own keys
# Platform LLM (if you want a single shared one): set OPENAI_API_KEY/OPENAI_MODEL,
# GOOGLE_API_KEY/GOOGLE_MODEL, or CUSTOM_LLM_URL/CUSTOM_LLM_API_KEY/CUSTOM_MODEL here.

# =============================================================================
# Auth (optional extras)
# =============================================================================

# DISABLE_AUTH=false
# AUTH_OVERRIDE_FROM_ENV=true
# RESET_AUTH=true

# =============================================================================
# LLM providers — fill only the one matching LLM=
# =============================================================================

# --- OpenAI ---
# LLM=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Google Gemini ---
# LLM=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=models/gemini-2.0-flash

# --- OpenAI-compatible (vLLM, LiteLLM proxy, etc.) ---
# LLM=custom
# CUSTOM_LLM_URL=http://host.docker.internal:8000/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_MODEL=

# EXTENDED_REASONING=true
# DISABLE_THINKING=true

# =============================================================================
# Slide images
# IMAGE_PROVIDER: gemini_flash | nanobanana_pro | gpt-image-1.5 | openai_compatible
# =============================================================================

# DISABLE_IMAGE_GENERATION=false
# ENABLE_PARALLEL_IMAGE_GENERATION=true
# IMAGE_PROVIDER=gpt-image-1.5

# GPT_IMAGE_1_5_QUALITY=

# OPENAI_COMPAT_IMAGE_BASE_URL=
# OPENAI_COMPAT_IMAGE_API_KEY=
# OPENAI_COMPAT_IMAGE_MODEL=

# =============================================================================
# Mem0 (presentation memory)
# Defaults point at OpenAI. Keep MEM0_ENABLED=false unless OPENAI_API_KEY is set
# (or override MEM0_LLM_* below).
# =============================================================================

# MEM0_ENABLED=true
# MEM0_LLM_BASE_URL=https://api.openai.com/v1
# MEM0_LLM_API_KEY=sk-...
# MEM0_LLM_MODEL=gpt-4.1-mini
# MEM0_DIR=/app_data/mem0
# MEM0_EMBEDDER_PROVIDER=openai
# MEM0_EMBEDDER_MODEL=text-embedding-3-small
# MEM0_EMBEDDING_DIMS=1536
# MEM0_SPACY_MODEL=en_core_web_sm
# MEM0_REQUIRE_SPACY_MODEL=true

# =============================================================================
# Document parse / web search
# =============================================================================

# LITEPARSE_DPI=120
# LITEPARSE_NUM_WORKERS=1

# WEB_GROUNDING=true
# WEB_SEARCH_PROVIDER=auto
# auto = OpenAI/Google native search, otherwise SearXNG sidecar
# WEB_SEARCH_MAX_RESULTS=
# SEARXNG_BASE_URL=http://searxng:8080
# SEARXNG_HOST_PORT=127.0.0.1:8080
# Secret is in deploy/searxng/settings.yml (must not be ultrasecretkey).
