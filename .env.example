# Copy this file to .env (Compose reads .env next to docker-compose.yml):
#   copy .env.example .env
#
# Fill in one LLM provider, then:
#   docker compose up production --build
# App: http://localhost:5001
#
# After changing .env, recreate the container:
#   docker compose up production --force-recreate

# =============================================================================
# Minimal setup (enough to generate slides)
# =============================================================================

PRESENTON_HTTP_HOST_PORT=5001

# openai | google | anthropic | ollama | azure | vertex | bedrock | openrouter
# fireworks | together | cerebras | deepseek | litellm | lmstudio | custom | codex
LLM=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# true = keys can be changed in Settings. false = lock keys from the UI.
CAN_CHANGE_KEYS=true

# Created on first boot. Password must be at least 8 characters.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password

# Default Mem0 target is Ollama on the host. Disable unless you configured MEM0_LLM_*.
MEM0_ENABLED=false

# Optional: skip slide images until an IMAGE_PROVIDER is configured.
DISABLE_IMAGE_GENERATION=true

DISABLE_ANONYMOUS_TRACKING=true

# =============================================================================
# Docker / runtime
# =============================================================================

# Host port mapped to container :80 (same as PRESENTON_HTTP_HOST_PORT above).
# PRESENTON_HOST_HTTP_PORT=5001

# linux/amd64 (default) | linux/arm64
# PRESENTON_DOCKER_PLATFORM=linux/amd64

# Leave empty to use SQLite under ./app_data. Compose already sets MIGRATE_DATABASE_ON_STARTUP=true.
# DATABASE_URL=postgresql://presenton:password@postgres:5432/presenton

# =============================================================================
# Auth (optional extras)
# =============================================================================

# AUTH_OVERRIDE_FROM_ENV=true
# RESET_AUTH=true

# =============================================================================
# LLM providers — fill only the one matching LLM=
# =============================================================================

# --- OpenAI ---
# LLM=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Google Gemini ---
# LLM=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=models/gemini-2.0-flash

# --- Anthropic ---
# LLM=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama on the host (not inside the container) ---
# LLM=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b
# START_OLLAMA=false

# --- OpenAI-compatible (vLLM, LiteLLM proxy, etc.) ---
# LLM=custom
# CUSTOM_LLM_URL=http://host.docker.internal:8000/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_MODEL=

# --- Azure OpenAI ---
# LLM=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_MODEL=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=

# --- Vertex ---
# LLM=vertex
# VERTEX_API_KEY=
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_PROJECT=
# VERTEX_LOCATION=
# VERTEX_BASE_URL=

# --- AWS Bedrock ---
# LLM=bedrock
# BEDROCK_REGION=us-east-1
# BEDROCK_API_KEY=
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
# BEDROCK_PROFILE_NAME=
# BEDROCK_MODEL=

# --- OpenRouter ---
# LLM=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=

# --- Fireworks ---
# LLM=fireworks
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=
# FIREWORKS_BASE_URL=

# --- Together ---
# LLM=together
# TOGETHER_API_KEY=
# TOGETHER_MODEL=
# TOGETHER_BASE_URL=

# --- Cerebras ---
# LLM=cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=
# CEREBRAS_BASE_URL=

# --- DeepSeek ---
# LLM=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=

# --- LiteLLM ---
# LLM=litellm
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=

# --- LM Studio ---
# LLM=lmstudio
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234
# LMSTUDIO_API_KEY=
# LMSTUDIO_MODEL=

# --- Codex ---
# LLM=codex
# CODEX_MODEL=

# EXTENDED_REASONING=true
# DISABLE_THINKING=true

# =============================================================================
# Slide images
# IMAGE_PROVIDER: pexels | pixabay | gemini_flash | nanobanana_pro | dall-e-3
#                 gpt-image-1.5 | comfyui | open_webui | openai_compatible
# =============================================================================

# DISABLE_IMAGE_GENERATION=false
# ENABLE_PARALLEL_IMAGE_GENERATION=true
# IMAGE_PROVIDER=dall-e-3

# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# DALL_E_3_QUALITY=
# GPT_IMAGE_1_5_QUALITY=

# COMFYUI_URL=
# COMFYUI_WORKFLOW=

# OPEN_WEBUI_IMAGE_URL=
# OPEN_WEBUI_IMAGE_API_KEY=

# OPENAI_COMPAT_IMAGE_BASE_URL=
# OPENAI_COMPAT_IMAGE_API_KEY=
# OPENAI_COMPAT_IMAGE_MODEL=

# =============================================================================
# Mem0 (presentation memory)
# Defaults point at Ollama on the host. If LLM is OpenAI and Ollama is not
# running, either keep MEM0_ENABLED=false or set MEM0_LLM_* to OpenAI.
# =============================================================================

# MEM0_ENABLED=true
# MEM0_LLM_BASE_URL=https://api.openai.com/v1
# MEM0_LLM_API_KEY=sk-...
# MEM0_LLM_MODEL=gpt-4.1-mini
# MEM0_DIR=/app_data/mem0
# MEM0_EMBEDDER_PROVIDER=fastembed
# MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# MEM0_EMBEDDING_DIMS=384
# MEM0_SPACY_MODEL=en_core_web_sm
# MEM0_REQUIRE_SPACY_MODEL=true

# =============================================================================
# Document parse / web search
# =============================================================================

# LITEPARSE_DPI=120
# LITEPARSE_NUM_WORKERS=1

# WEB_GROUNDING=true
# WEB_SEARCH_PROVIDER=auto
# WEB_SEARCH_MAX_RESULTS=
# SEARXNG_BASE_URL=
# TAVILY_API_KEY=
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
